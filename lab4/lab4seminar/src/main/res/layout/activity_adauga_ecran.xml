<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AdaugaEcran">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurare Ecran"
            tools:layout_editor_absoluteX="172dp"
            tools:layout_editor_absoluteY="136dp" />

        <EditText
            android:id="@+id/etProducator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="10"
            android:inputType="text"
            android:hint="@string/producator_ex_samsung"
            tools:layout_editor_absoluteX="93dp"
            tools:layout_editor_absoluteY="225dp" />

        <CheckBox
            android:id="@+id/cbOled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ecran Oled" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Format ecran:"
            android:textStyle="bold" />
        <RadioGroup
            android:id="@+id/rgFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16:9" />
            <RadioButton
                android:id="@+id/radioButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21:9" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rezolutie"
            android:textStyle="bold"/>
        <Spinner
            android:id="@+id/spinnerRezolutie"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:entries="@array/rezolutii_array"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switchSmart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Functii Smart TV"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating calitate:"
            android:textStyle="bold"/>

        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALVEAZA"
            android:onClick="salveazaDatele"/>


    </LinearLayout>

</LinearLayout>